+// Copyright (c) 2026 Cloudflare, Inc.
+// Licensed under the Apache 2.0 license found in the LICENSE file or at:
+// https://opensource.org/licenses/Apache-2.0
+
+// Loads each PageScript generation in its own loopback request context. A worker stub held by the
+// long-lived CDP connection kept every retired page isolate resident until host GC or disconnect;
+// here the isolate's lifetime ends when the caller disposes the returned session and control stubs.
+
+import { RpcTarget, WorkerEntrypoint } from "cloudflare:workers";
+import type { OpenSessionInit, PageScriptEntrypoint } from "@kitesurf/jsrpc-types/page-script";
+import type { OutboundProps } from "./outbound.ts";
+import {
+  attributionTails,
+  type AttributionTailExports,
+  type AttributionTailProps,
+} from "./attribution-tail.ts";
+import type { PageScriptTailProps } from "./page-script-tail.ts";
+import type { RpcSessionCallable, RpcSessionEntrypoint } from "./page-script-rpc-session.ts";
+import { STATIC_PAGE_SCRIPT_MODULES } from "./page-script-modules.ts";
+
+export type PageScriptLoadModule =
+  | string
+  | { wasm: ArrayBuffer }
+  | { cjs: string }
+  | { js: string }
+  | { json: unknown };
+
+/** Serializable description of one generation; static engine modules are added by the loader. */
+export interface PageScriptLoadSpec {
+  compatibilityDate: string;
+  compatibilityFlags: string[];
+  mainModule: string;
+  modules: Record<string, PageScriptLoadModule>;
+  outboundProps: OutboundProps;
+  tail: PageScriptTailProps;
+  attributionTail?: AttributionTailProps;
+  spanSinkProps?: { kind: string } & Record<string, unknown>;
+  limits: { cpuMs?: number; subRequests?: number };
+  entrypointProps: Record<string, unknown>;
+}
+
+export interface LoadedPageScript {
+  session: RpcSessionCallable;
+  control: LoadedPageScriptControl;
+}
+
+type LoaderExports = AttributionTailExports & {
+  SandboxOutbound(opts: { props: OutboundProps }): Fetcher;
+  PageScriptTail(opts: { props: PageScriptTailProps }): Fetcher;
+  SpanSink(opts: { props: Record<string, unknown> }): unknown;
+};
+
+interface LoaderEnv {
+  LOADER: WorkerLoader;
+  HOST_TRACER?: unknown;
+}
+
+/** Kill switch for one loaded generation. Disposing it lets the loader context end. */
+export class LoadedPageScriptControl extends RpcTarget {
+  #entrypoint: Fetcher<PageScriptEntrypoint> | null;
+
+  constructor(entrypoint: Fetcher<PageScriptEntrypoint>) {
+    super();
+    this.#entrypoint = entrypoint;
+  }
+
+  async killIsolate(reason?: string): Promise<void> {
+    await this.#entrypoint?.killIsolate(reason);
+  }
+
+  [Symbol.dispose](): void {
+    this.#entrypoint = null;
+  }
+}
+
+export class PageScriptLoader extends WorkerEntrypoint<LoaderEnv> {
+  async open(spec: PageScriptLoadSpec, init: OpenSessionInit): Promise<LoadedPageScript> {
+    const exports = (this.ctx as ExecutionContext & { exports: LoaderExports }).exports;
+    const tails: Fetcher[] = [
+      exports.PageScriptTail({ props: spec.tail }),
+      ...(spec.attributionTail
+        ? attributionTails(exports, spec.attributionTail.headers, spec.attributionTail.scriptName)
+        : []),
+    ];
+    const stub = this.env.LOADER.load({
+      compatibilityDate: spec.compatibilityDate,
+      compatibilityFlags: spec.compatibilityFlags,
+      mainModule: spec.mainModule,
+      // Engine modules win, as in pageIsolateEntry.
+      modules: { ...spec.modules, ...STATIC_PAGE_SCRIPT_MODULES },
+      env: {
+        ...(this.env.HOST_TRACER && spec.spanSinkProps
+          ? { KS_SPAN_SINK: exports.SpanSink({ props: spec.spanSinkProps }) }
+          : {}),
+      },
+      globalOutbound: exports.SandboxOutbound({ props: spec.outboundProps }),
+      tails,
+      limits: spec.limits,
+    });
+    const entrypoint = stub.getEntrypoint<PageScriptEntrypoint>("PageScript", {
+      props: spec.entrypointProps,
+    });
+    // SAFETY: WorkerLoader follows the PageScript JSRPC contract; Rpc.Provider only loses generic
+    // call/reply correlation. Verified by: packages/engine/test/e2e/demos/page-script-demo.e2e.test.ts.
+    const opener = entrypoint as RpcSessionEntrypoint;
+    const session = await opener.openSession(init);
+    return { session, control: new LoadedPageScriptControl(entrypoint) };
+  }
+}
