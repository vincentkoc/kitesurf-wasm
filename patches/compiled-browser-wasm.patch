+  let released = false;
+  const disposeLoaded = (value: LoadedPageScript) => {
+    for (const stub of [value.control, value.session, value]) {
+      try {
+        (stub as { [Symbol.dispose]?: () => void })[Symbol.dispose]?.();
+      } catch {}
+    }
+  };
+  return {
+    async openSession(init) {
+      const value = await loader.open(spec, init);
+      if (released) {
+        disposeLoaded(value);
+        throw new Error("PageScript generation released before its session opened");
