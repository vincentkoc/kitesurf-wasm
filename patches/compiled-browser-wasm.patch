+      return value.session;
+    },
+    killIsolate(reason) {
+      return loaded ? loaded.control.killIsolate(reason) : Promise.resolve();
+    },
+    release() {
+      if (released) return;
+      released = true;
+      const value = loaded;
+      loaded = null;
+      if (value) disposeLoaded(value);
+    },
