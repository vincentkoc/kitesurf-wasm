+
+describe("loader-owned generation release", () => {
+  it("releases the loaded generation once, after the kill settles", async () => {
+    const order: string[] = [];
+    const fake = makeFake();
+    fake.entrypoint.killIsolate = async () => {
+      order.push("kill");
+    };
+    fake.entrypoint.release = () => {
+      order.push("release");
+    };
+    const s = openPageScriptRpcSession(fake.entrypoint);
+    await s.syncCookies("warm=up");
+    s.close("generation bump");
+    await s.killIsolate("generation bump");
+    await s.killIsolate("again");
+    expect(order).toEqual(["kill", "release"]);
+  });
+
+  it("releases even when the kill rejects or never settles", async () => {
+    vi.useFakeTimers();
+    try {
+      for (const kill of [
+        async () => {
+          throw new Error("kill failed");
+        },
+        () => new Promise<void>(() => {}),
+      ]) {
+        let released = 0;
+        const fake = makeFake({ onClose: () => new Promise(() => {}) });
+        fake.entrypoint.killIsolate = kill;
+        fake.entrypoint.release = () => {
+          released += 1;
+        };
+        const s = openPageScriptRpcSession(fake.entrypoint);
+        await s.syncCookies("warm=up");
+        s.close("generation bump");
+        const killing = s.killIsolate("generation bump");
+        await vi.advanceTimersByTimeAsync(2_000);
+        await killing;
+        expect(released).toBe(1);
+      }
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it("releases an isolate already known to be gone without killing it", async () => {
+    let killed = 0;
+    let released = 0;
+    const s = openPageScriptRpcSession({
+      openSession: async () => {
+        throw new Error("open failed");
+      },
+      killIsolate: async () => {
+        killed += 1;
+      },
+      release: () => {
+        released += 1;
+      },
+    });
+    await expect(s.syncCookies("warm=up")).rejects.toThrow();
+    await s.killIsolate("generation bump");
+    expect(killed).toBe(0);
+    expect(released).toBe(1);
+  });
+});
