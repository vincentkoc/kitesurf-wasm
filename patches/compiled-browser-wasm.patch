+        [Symbol.dispose]() {
+          disposed += 1;
+        },
+      };
+      const s = openPageScriptRpcSession({
+        openSession: () => new Promise((resolve) => (resolveOpen = resolve)),
+        killIsolate: async () => {},
+      });
+      s.close("generation bump");
