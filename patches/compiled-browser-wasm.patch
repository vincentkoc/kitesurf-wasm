+// Give page tasks queued by an engine call up to `maxTurns` task turns before its reply.
+// Each turn is a workerd setTimeout(0), about 1.3 ms of wall clock even when no page task
+// is due, so stop once nothing is due instead of paying an idle turn. A skipped turn would
+// only have run its own wheel entry, whose remaining effect is the boa job drain.
+export async function yieldToDuePageTasks(maxTurns: number): Promise<void> {
+  for (let turn = 0; turn < maxTurns; turn++) {
+    await drainSettleMicrotasks();
+    if (!pageTimerDueWithin(0)) {
+      runBridgedPageJobs();
+      await drainSettleMicrotasks();
+      if (!pageTimerDueWithin(0)) return;
+    }
+    await yieldToPageTasks();
+  }
