+/**
+ * Opens a generation through the loopback PageScriptLoader so its isolate is released when the
+ * generation is torn down, not when the connection ends or host GC finalizes a worker stub.
+ */
+function loaderOwnedEntrypoint(
+  // The local contract, not the generated loopback type: the session reply is the raw JSRPC stub.
+  loader: PageScriptLoaderStub,
+  spec: PageScriptLoadSpec,
